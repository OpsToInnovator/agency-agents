# /etc/arbbot/live.env  (chmod 600, owner root:arbbot; loaded by the arbbot-live service ONLY)
# The Binance API key: spot trading enabled, withdrawals DISABLED, restricted to this machine's IP.
# Never paste these anywhere else, never commit this file, never put them in live.toml.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Stage B (validation-only orders): leave empty.
# Stage C (real orders): set to --i-know-this-sends-real-orders AND set real_orders = true in live.toml.
ARBBOT_LIVE_FLAGS=
